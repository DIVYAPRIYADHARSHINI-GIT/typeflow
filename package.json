{
  "name": "typeflow",
  "private": true,
  "version": "1.0.0",
  "description": "TypeFlow - Type faster. Type right. Free, browser-only English typing speed test and practice platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "oxlint src",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "test:design": "node scripts/design-qa.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run test:design"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
